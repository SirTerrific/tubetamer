<?xml version="1.0" encoding="utf-8"?>
<!--
  TubeTamer talks only to the server address the parent configures, which is
  normally a plain-HTTP address on the home network (e.g. http://192.168.x.x:8080).
  Android cannot whitelist an IP range, so cleartext is allowed. Tokens therefore
  travel unencrypted on the LAN; use a trusted home network or an HTTPS reverse proxy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
